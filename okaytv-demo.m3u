#EXTINF:-1 tvg-id="mv-0005-fr-films" tvg-name="Neon Harbor (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-01.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="6.9" tvg-runtime="116" tvg-cast="Freya Ostberg, Aleks Norrback, Hedda Wulfson" tvg-director="Rasmus Ehlert" group-title="FR | Films",Neon Harbor (2023)
