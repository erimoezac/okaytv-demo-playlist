#EXTINF:-1 tvg-id="mv-0335-de-4k-uhd-filme" tvg-name="Neon Harbor: Fährmann (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-12.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.7" tvg-runtime="121" tvg-cast="Ivar Bengtsson, Arno Delacroix, Marek Halvorsen" tvg-director="Mira Kaltenbach" group-title="DE | 4K UHD Filme",Neon Harbor: Fährmann (2026)
