#EXTINF:-1 tvg-id="mv-0303-en-drama-romance" tvg-name="The Silent Atlas – Bernsteinroute" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/silent-atlas-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/silent-atlas.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/silent-atlas.png" tvg-plot="Eine alte Seekarte führt an eine Küste, die auf keiner heutigen Karte steht. Was als Expedition beginnt, wird zur Suche nach den Leuten, die dort einmal gelebt haben — und nach dem Grund, warum niemand ihre Spuren aufschreiben wollte." tvg-genre="Abenteuer, Dokumentation" tvg-age="6" tvg-rating="7.9" tvg-runtime="113" tvg-cast="Milan Voskuil, Sanna Lindqvist, Vera Ahlgren" tvg-director="Halvard Nyström" group-title="EN | Drama & Romance",The Silent Atlas – Bernsteinroute
