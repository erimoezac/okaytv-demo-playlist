#EXTINF:-1 tvg-id="mv-0130-en-new-movies" tvg-name="Iron Dawn – Sammelstelle (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="7.8" tvg-runtime="124" tvg-cast="Aleks Norrback, Juno Marchetti, Selma Rutkowski" tvg-director="Emile Bouchard" group-title="EN | New Movies",Iron Dawn – Sammelstelle (2023)
