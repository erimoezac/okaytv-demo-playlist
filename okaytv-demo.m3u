#EXTINF:-1 tvg-id="mv-0017-fr-films" tvg-name="Lanternwood (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-01.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="8.3" tvg-runtime="94" tvg-cast="Rieke Sandmann, Nora Vestergaard, Ines Brandtner" tvg-director="Stellan Broch" group-title="FR | Films",Lanternwood (2022)
