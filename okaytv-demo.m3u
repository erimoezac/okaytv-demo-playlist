#EXTINF:-1 tvg-id="mv-0037-de-filmreihen-boxsets" tvg-name="Beyond Horizons: Talsperre (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="8.1" tvg-runtime="110" tvg-cast="Juno Marchetti, Liv Aarhusen, Juno Marchetti" tvg-director="Yannick Roussel" group-title="DE | Filmreihen & Boxsets",Beyond Horizons: Talsperre (2024)
