#EXTINF:-1 tvg-id="mv-0126-en-new-movies" tvg-name="After the Fall – Trinkwasser (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/after-the-fall-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/after-the-fall.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/after-the-fall.png" tvg-plot="Dreißig Jahre nachdem die Städte leer wurden, wächst zwischen den Hochhäusern ein Wald. Ein Kundschafter soll herausfinden, wer die Signale sendet, die seit dem Frühjahr aus dem alten Zentrum kommen — und was aus denen wurde, die nie gegangen sind." tvg-genre="Science Fiction, Drama" tvg-age="12" tvg-rating="6.9" tvg-runtime="132" tvg-cast="Nora Vestergaard, Hedda Wulfson, Mira Toivonen" tvg-director="Yannick Roussel" group-title="EN | New Movies",After the Fall – Trinkwasser (2023)
