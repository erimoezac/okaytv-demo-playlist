#EXTINF:-1 tvg-id="mv-0361-de-drama" tvg-name="Northbound – Funkschatten (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.7" tvg-runtime="123" tvg-cast="Tomas Ekvall, Aleks Norrback, Cassian Merle" tvg-director="Yannick Roussel" group-title="DE | Drama",Northbound – Funkschatten (2024)
