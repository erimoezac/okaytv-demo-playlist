#EXTINF:-1 tvg-id="mv-0334-de-4k-uhd-filme" tvg-name="Ashes of Tomorrow: Wasserzeichen (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-12.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="7.0" tvg-runtime="103" tvg-cast="Liv Aarhusen, Ivar Bengtsson, Aleks Norrback" tvg-director="Céline Marchand" group-title="DE | 4K UHD Filme",Ashes of Tomorrow: Wasserzeichen (2026)
