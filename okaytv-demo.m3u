#EXTINF:-1 tvg-id="mv-0304-en-drama-romance" tvg-name="Ashes of Tomorrow – Nordlicht" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="6.6" tvg-runtime="123" tvg-cast="Ines Brandtner, Cassian Merle, Sanna Lindqvist" tvg-director="Anouk Verhagen" group-title="EN | Drama & Romance",Ashes of Tomorrow – Nordlicht
