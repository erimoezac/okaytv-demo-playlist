#EXTINF:-1 tvg-id="mv-0384-de-drama" tvg-name="The Weeping Pines – Baumreihe (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/the-weeping-pines-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/the-weeping-pines.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/the-weeping-pines.png" tvg-plot="In diesem Waldstück verschwinden keine Menschen — sie kommen zurück, nur eben nicht ganz. Ein Förster geht der Sache mit einer Taschenlampe und deutlich zu viel Zutrauen nach." tvg-genre="Horror, Mystery" tvg-age="18" tvg-rating="7.0" tvg-runtime="97" tvg-cast="Tomas Ekvall, Nora Vestergaard, Milan Voskuil" tvg-director="Yannick Roussel" group-title="DE | Drama",The Weeping Pines – Baumreihe (2024)
