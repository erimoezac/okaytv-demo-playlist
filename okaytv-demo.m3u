#EXTINF:-1 tvg-id="mv-0151-de-doku-reportage" tvg-name="Northbound: Polarnacht (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.1" tvg-runtime="113" tvg-cast="Arno Delacroix, Selma Rutkowski, Juno Marchetti" tvg-director="Mira Kaltenbach" group-title="DE | Doku & Reportage",Northbound: Polarnacht (2021)
