#EXTINF:-1 tvg-id="mv-0040-de-filmreihen-boxsets" tvg-name="Iron Dawn: Bergungstrupp (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="7.1" tvg-runtime="120" tvg-cast="Milan Voskuil, Vera Ahlgren, Marek Halvorsen" tvg-director="Mira Kaltenbach" group-title="DE | Filmreihen & Boxsets",Iron Dawn: Bergungstrupp (2024)
