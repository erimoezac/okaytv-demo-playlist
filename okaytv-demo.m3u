#EXTINF:-1 tvg-id="mv-0306-en-drama-romance" tvg-name="After the Fall – Nachbarschaft" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/after-the-fall-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/after-the-fall.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/after-the-fall.png" tvg-plot="Dreißig Jahre nachdem die Städte leer wurden, wächst zwischen den Hochhäusern ein Wald. Ein Kundschafter soll herausfinden, wer die Signale sendet, die seit dem Frühjahr aus dem alten Zentrum kommen — und was aus denen wurde, die nie gegangen sind." tvg-genre="Science Fiction, Drama" tvg-age="12" tvg-rating="7.4" tvg-runtime="102" tvg-cast="Roman Kesselring, Hedda Wulfson, Liv Aarhusen" tvg-director="Rasmus Ehlert" group-title="EN | Drama & Romance",After the Fall – Nachbarschaft
