#EXTINF:-1 tvg-id="mv-0039-de-filmreihen-boxsets" tvg-name="Eclipse Protocol: Funkstille (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.2" tvg-runtime="126" tvg-cast="Milan Voskuil, Sanna Lindqvist, Rieke Sandmann" tvg-director="Ida Sonnleitner" group-title="DE | Filmreihen & Boxsets",Eclipse Protocol: Funkstille (2024)
