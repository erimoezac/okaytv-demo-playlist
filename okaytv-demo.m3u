#EXTINF:-1 tvg-id="mv-0129-en-new-movies" tvg-name="Eclipse Protocol – Schattenseite (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.9" tvg-runtime="142" tvg-cast="Nora Vestergaard, Tomas Ekvall, Mira Toivonen" tvg-director="Nadja Wolanski" group-title="EN | New Movies",Eclipse Protocol – Schattenseite (2023)
