#EXTINF:-1 tvg-id="mv-0480-de-action-abenteuer" tvg-name="Shadow Vigil: Morgengrauen (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/shadow-vigil-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/shadow-vigil.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/shadow-vigil.png" tvg-plot="Er arbeitet nachts, spricht mit niemandem und hinterlässt an jedem Tatort dasselbe Zeichen. Die Stadt hält ihn für ihren Schutz — bis jemand fragt, wovor er sie eigentlich beschützt." tvg-genre="Action, Krimi" tvg-age="16" tvg-rating="7.7" tvg-runtime="117" tvg-cast="Emil Ravnborg, Rieke Sandmann, Bastian Kohl" tvg-director="Katrin Sjöberg" group-title="DE | Action & Abenteuer",Shadow Vigil: Morgengrauen (2023)
