#EXTINF:-1 tvg-id="mv-0459-de-komodie" tvg-name="Eclipse Protocol: Sonnenwind (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.6" tvg-runtime="133" tvg-cast="Sanna Lindqvist, Aleks Norrback, Marek Halvorsen" tvg-director="Halvard Nyström" group-title="DE | Komödie",Eclipse Protocol: Sonnenwind (2023)
