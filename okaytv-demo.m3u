#EXTINF:-1 tvg-id="sr-box-the-silent-atlas-expeditionen-s1" tvg-name="The Silent Atlas: Expeditionen S01 (Komplette Staffel)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/silent-atlas-03.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/silent-atlas.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/silent-atlas.png" tvg-plot="Eine alte Seekarte führt an eine Küste, die auf keiner heutigen Karte steht. Was als Expedition beginnt, wird zur Suche nach den Leuten, die dort einmal gelebt haben — und nach dem Grund, warum niemand ihre Spuren aufschreiben wollte." tvg-genre="Abenteuer, Dokumentation" tvg-age="6" tvg-rating="7.6" tvg-runtime="101" tvg-cast="Bastian Kohl, Rieke Sandmann, Ines Brandtner" tvg-director="Rasmus Ehlert" group-title="DE | Serien Boxsets",The Silent Atlas: Expeditionen S01 (Komplette Staffel)
