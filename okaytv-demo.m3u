#EXTINF:-1 tvg-id="mv-0187-it-film" tvg-name="Beyond Horizons – Wanderpass (2020)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-07.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.2" tvg-runtime="120" tvg-cast="Bastian Kohl, Rieke Sandmann, Mira Toivonen" tvg-director="Halvard Nyström" group-title="IT | Film",Beyond Horizons – Wanderpass (2020)
