#EXTINF:-1 tvg-id="mv-0301-en-drama-romance" tvg-name="Northbound – Der Pass" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.2" tvg-runtime="101" tvg-cast="Freya Ostberg, Ivar Bengtsson, Tomas Ekvall" tvg-director="Stellan Broch" group-title="EN | Drama & Romance",Northbound – Der Pass
