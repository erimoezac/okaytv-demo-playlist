#EXTINF:-1 tvg-id="mv-0123-en-new-movies" tvg-name="The Silent Atlas – Das Kartenzimmer (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/silent-atlas-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/silent-atlas.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/silent-atlas.png" tvg-plot="Eine alte Seekarte führt an eine Küste, die auf keiner heutigen Karte steht. Was als Expedition beginnt, wird zur Suche nach den Leuten, die dort einmal gelebt haben — und nach dem Grund, warum niemand ihre Spuren aufschreiben wollte." tvg-genre="Abenteuer, Dokumentation" tvg-age="6" tvg-rating="7.6" tvg-runtime="89" tvg-cast="Tomas Ekvall, Cassian Merle, Marek Halvorsen" tvg-director="Ida Sonnleitner" group-title="EN | New Movies",The Silent Atlas – Das Kartenzimmer (2025)
