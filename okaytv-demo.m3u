#EXTINF:-1 tvg-id="mv-0035-de-filmreihen-boxsets" tvg-name="Neon Harbor: Hafenlichter (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.8" tvg-runtime="103" tvg-cast="Freya Ostberg, Nikolas Ferrand, Nora Vestergaard" tvg-director="Ida Sonnleitner" group-title="DE | Filmreihen & Boxsets",Neon Harbor: Hafenlichter (2024)
