#EXTINF:-1 tvg-id="mv-0429-de-klassiker" tvg-name="Eclipse Protocol – Wartungsschacht (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-15.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.3" tvg-runtime="111" tvg-cast="Arno Delacroix, Marek Halvorsen, Milan Voskuil" tvg-director="Rasmus Ehlert" group-title="DE | Klassiker",Eclipse Protocol – Wartungsschacht (2025)
