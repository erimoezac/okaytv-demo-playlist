#EXTINF:-1 tvg-id="mv-0220-en-action" tvg-name="Iron Dawn: Nachschubweg" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-08.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="8.1" tvg-runtime="112" tvg-cast="Thea Lindgren, Ivar Bengtsson, Ines Brandtner" tvg-director="Ida Sonnleitner" group-title="EN | Action",Iron Dawn: Nachschubweg
