#EXTINF:-1 tvg-id="mv-0155-de-doku-reportage" tvg-name="Neon Harbor: Containerbucht (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.4" tvg-runtime="110" tvg-cast="Milan Voskuil, Thea Lindgren, Hedda Wulfson" tvg-director="Emile Bouchard" group-title="DE | Doku & Reportage",Neon Harbor: Containerbucht (2021)
