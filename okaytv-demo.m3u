#EXTINF:-1 tvg-id="mv-0159-de-doku-reportage" tvg-name="Eclipse Protocol: Trockendock (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.0" tvg-runtime="140" tvg-cast="Sanna Lindqvist, Marek Halvorsen, Arno Delacroix" tvg-director="Katrin Sjöberg" group-title="DE | Doku & Reportage",Eclipse Protocol: Trockendock (2021)
