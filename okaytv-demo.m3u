#EXTINF:-1 tvg-id="mv-0118-de-action-abenteuer" tvg-name="Aurora Sentinel: Morgenschein (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/aurora-sentinel-04.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/aurora-sentinel.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/aurora-sentinel.png" tvg-plot="Sie kann das Licht der Stadt in den Händen halten, und die Stadt weiß bis heute nicht, wem sie das verdankt. Als die Lichter zum ersten Mal ausgehen, muss sie sich entscheiden, ob sie länger unerkannt bleiben will." tvg-genre="Action, Fantasy" tvg-age="12" tvg-rating="7.3" tvg-runtime="144" tvg-cast="Bastian Kohl, Milan Voskuil, Sanna Lindqvist" tvg-director="Rasmus Ehlert" group-title="DE | Action & Abenteuer",Aurora Sentinel: Morgenschein (2026)
