#EXTINF:-1 tvg-id="mv-0479-de-action-abenteuer" tvg-name="Nova Strike: Nachtschicht (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/nova-strike-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/nova-strike.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/nova-strike.png" tvg-plot="Ein Blitz, der nicht vom Himmel kam, gibt einem Streifenpolizisten mehr Kraft, als eine Stadt verträgt. Seine Vorgesetzten wollen sie einsetzen, seine Nachbarn wollen nur ihre Ruhe." tvg-genre="Action, Science Fiction" tvg-age="12" tvg-rating="6.8" tvg-runtime="111" tvg-cast="Freya Ostberg, Emil Ravnborg, Ines Brandtner" tvg-director="Stellan Broch" group-title="DE | Action & Abenteuer",Nova Strike: Nachtschicht (2023)
