#EXTINF:-1 tvg-id="mv-0363-de-drama" tvg-name="The Silent Atlas – Höhle der Ahnen (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/silent-atlas-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/silent-atlas.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/silent-atlas.png" tvg-plot="Eine alte Seekarte führt an eine Küste, die auf keiner heutigen Karte steht. Was als Expedition beginnt, wird zur Suche nach den Leuten, die dort einmal gelebt haben — und nach dem Grund, warum niemand ihre Spuren aufschreiben wollte." tvg-genre="Abenteuer, Dokumentation" tvg-age="6" tvg-rating="7.8" tvg-runtime="103" tvg-cast="Jonan Petrescu, Bastian Kohl, Selma Rutkowski" tvg-director="Piet Vandersteen" group-title="DE | Drama",The Silent Atlas – Höhle der Ahnen (2022)
