#EXTINF:-1 tvg-id="mv-0457-de-komodie" tvg-name="Beyond Horizons: Umkehrpunkt (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.0" tvg-runtime="96" tvg-cast="Nikolas Ferrand, Freya Ostberg, Thea Lindgren" tvg-director="Ida Sonnleitner" group-title="DE | Komödie",Beyond Horizons: Umkehrpunkt (2023)
