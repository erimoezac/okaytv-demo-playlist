#EXTINF:-1 tvg-id="mv-0018-fr-films" tvg-name="Skygarden Voyage (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/skygarden-voyage-01.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/skygarden-voyage.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/skygarden-voyage.png" tvg-plot="Eine Erfinderin baut aus einem Bollerwagen und einem Heißluftballon ein Gefährt, das über die Wolken steigt. Oben treibt ein Garten, den seit hundert Jahren niemand gegossen hat — und er wartet ganz offensichtlich auf jemanden." tvg-genre="Animation, Abenteuer" tvg-age="0" tvg-rating="7.9" tvg-runtime="89" tvg-cast="Thea Lindgren, Sanna Lindqvist, Arno Delacroix" tvg-director="Mira Kaltenbach" group-title="FR | Films",Skygarden Voyage (2022)
