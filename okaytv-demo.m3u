#EXTINF:-1 tvg-id="mv-0407-tr-filmler" tvg-name="Lanternwood: Farnschatten (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-14.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="8.4" tvg-runtime="92" tvg-cast="Nikolas Ferrand, Mira Toivonen, Roman Kesselring" tvg-director="Katrin Sjöberg" group-title="TR | Filmler",Lanternwood: Farnschatten (2022)
