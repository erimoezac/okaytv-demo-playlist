#EXTINF:-1 tvg-id="mv-0124-en-new-movies" tvg-name="Ashes of Tomorrow – Funkstille (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="6.5" tvg-runtime="128" tvg-cast="Cassian Merle, Hedda Wulfson, Vera Ahlgren" tvg-director="Piet Vandersteen" group-title="EN | New Movies",Ashes of Tomorrow – Funkstille (2026)
