#EXTINF:-1 tvg-id="mv-0366-de-drama" tvg-name="After the Fall – Baumgrenze (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/after-the-fall-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/after-the-fall.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/after-the-fall.png" tvg-plot="Dreißig Jahre nachdem die Städte leer wurden, wächst zwischen den Hochhäusern ein Wald. Ein Kundschafter soll herausfinden, wer die Signale sendet, die seit dem Frühjahr aus dem alten Zentrum kommen — und was aus denen wurde, die nie gegangen sind." tvg-genre="Science Fiction, Drama" tvg-age="12" tvg-rating="7.6" tvg-runtime="116" tvg-cast="Selma Rutkowski, Sanna Lindqvist, Rieke Sandmann" tvg-director="Mira Kaltenbach" group-title="DE | Drama",After the Fall – Baumgrenze (2024)
