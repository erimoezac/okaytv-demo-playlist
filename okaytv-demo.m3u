#EXTINF:-1 tvg-id="mv-0107-es-peliculas" tvg-name="Lanternwood: Fuchsbau (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-04.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="7.6" tvg-runtime="84" tvg-cast="Roman Kesselring, Cassian Merle, Arno Delacroix" tvg-director="Emile Bouchard" group-title="ES | Películas",Lanternwood: Fuchsbau (2026)
