#EXTINF:-1 tvg-id="mv-0219-en-action" tvg-name="Eclipse Protocol: Randstation" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-08.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.7" tvg-runtime="131" tvg-cast="Hedda Wulfson, Rieke Sandmann, Bastian Kohl" tvg-director="Katrin Sjöberg" group-title="EN | Action",Eclipse Protocol: Randstation
