#EXTINF:-1 tvg-id="mv-0121-en-new-movies" tvg-name="Northbound – Packeis (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.0" tvg-runtime="103" tvg-cast="Juno Marchetti, Cassian Merle, Nora Vestergaard" tvg-director="Nadja Wolanski" group-title="EN | New Movies",Northbound – Packeis (2023)
