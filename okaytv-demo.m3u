#EXTINF:-1 tvg-id="mv-0119-de-action-abenteuer" tvg-name="Nova Strike: Überlast (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/nova-strike-04.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/nova-strike.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/nova-strike.png" tvg-plot="Ein Blitz, der nicht vom Himmel kam, gibt einem Streifenpolizisten mehr Kraft, als eine Stadt verträgt. Seine Vorgesetzten wollen sie einsetzen, seine Nachbarn wollen nur ihre Ruhe." tvg-genre="Action, Science Fiction" tvg-age="12" tvg-rating="6.9" tvg-runtime="125" tvg-cast="Thea Lindgren, Hedda Wulfson, Ivar Bengtsson" tvg-director="Emile Bouchard" group-title="DE | Action & Abenteuer",Nova Strike: Überlast (2026)
