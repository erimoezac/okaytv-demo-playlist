#EXTINF:-1 tvg-id="mv-0309-en-drama-romance" tvg-name="Eclipse Protocol – Bodenprobe" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="7.6" tvg-runtime="124" tvg-cast="Sanna Lindqvist, Bastian Kohl, Rieke Sandmann" tvg-director="Yannick Roussel" group-title="EN | Drama & Romance",Eclipse Protocol – Bodenprobe
