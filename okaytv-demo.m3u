#EXTINF:-1 tvg-id="mv-0038-de-filmreihen-boxsets" tvg-name="Crimson Files: Aktendeckel (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/crimson-files-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/crimson-files.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/crimson-files.png" tvg-plot="Eine Ermittlerin übernimmt einen Stapel Akten, den vor ihr drei Kollegen abgegeben haben. Die Fälle liegen Jahre auseinander und haben nichts gemeinsam — bis auf ein Detail, das in jedem Protokoll steht und das nie jemand aufgeschrieben haben wollte." tvg-genre="Krimi, Mystery" tvg-age="16" tvg-rating="7.9" tvg-runtime="104" tvg-cast="Liv Aarhusen, Arno Delacroix, Nikolas Ferrand" tvg-director="Ida Sonnleitner" group-title="DE | Filmreihen & Boxsets",Crimson Files: Aktendeckel (2024)
