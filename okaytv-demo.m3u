#EXTINF:-1 tvg-id="mv-0376-de-drama" tvg-name="Cosmo Crew – Sonnensegel (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/cosmo-crew-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/cosmo-crew.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/cosmo-crew.png" tvg-plot="Eine Hundeschnauze, eine Katzenpfote und ein Roboter, der ständig alles doppelt kontrolliert: Die Crew soll nur eine Kiste zum Nachbarmond bringen. Unterwegs geht die Kiste auf — und darin sitzt jemand, der auch nicht weiß, wie er da hineingeraten ist." tvg-genre="Animation, Familie" tvg-age="0" tvg-rating="7.7" tvg-runtime="82" tvg-cast="Roman Kesselring, Thea Lindgren, Juno Marchetti" tvg-director="Rasmus Ehlert" group-title="DE | Drama",Cosmo Crew – Sonnensegel (2024)
