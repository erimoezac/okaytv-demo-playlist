#EXTINF:-1 tvg-id="mv-0305-en-drama-romance" tvg-name="Neon Harbor – Molenkopf" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="6.9" tvg-runtime="95" tvg-cast="Rieke Sandmann, Cassian Merle, Freya Ostberg" tvg-director="Nadja Wolanski" group-title="EN | Drama & Romance",Neon Harbor – Molenkopf
