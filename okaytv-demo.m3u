#EXTINF:-1 tvg-id="mv-0425-de-thriller-krimi" tvg-name="Neon Harbor – Schleusenwärter (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-15.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.0" tvg-runtime="97" tvg-cast="Cassian Merle, Hedda Wulfson, Selma Rutkowski" tvg-director="Céline Marchand" group-title="DE | Thriller & Krimi",Neon Harbor – Schleusenwärter (2025)
