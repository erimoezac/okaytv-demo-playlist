#EXTINF:-1 tvg-id="mv-0455-de-komodie" tvg-name="Neon Harbor: Tidenhub (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.5" tvg-runtime="98" tvg-cast="Milan Voskuil, Jonan Petrescu, Arno Delacroix" tvg-director="Piet Vandersteen" group-title="DE | Komödie",Neon Harbor: Tidenhub (2023)
