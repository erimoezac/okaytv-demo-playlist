#EXTINF:-1 tvg-id="mv-0365-de-drama" tvg-name="Neon Harbor – Dockstraße (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.9" tvg-runtime="95" tvg-cast="Marek Halvorsen, Jonan Petrescu, Rieke Sandmann" tvg-director="Céline Marchand" group-title="DE | Drama",Neon Harbor – Dockstraße (2024)
