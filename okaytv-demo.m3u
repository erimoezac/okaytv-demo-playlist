#EXTINF:-1 tvg-id="mv-0157-de-doku-reportage" tvg-name="Beyond Horizons: Bergseen (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="8.1" tvg-runtime="109" tvg-cast="Hedda Wulfson, Rieke Sandmann, Emil Ravnborg" tvg-director="Mira Kaltenbach" group-title="DE | Doku & Reportage",Beyond Horizons: Bergseen (2021)
