#EXTINF:-1 tvg-id="mv-0154-de-doku-reportage" tvg-name="Ashes of Tomorrow: Staubjahre (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="7.5" tvg-runtime="123" tvg-cast="Ines Brandtner, Liv Aarhusen, Marek Halvorsen" tvg-director="Stellan Broch" group-title="DE | Doku & Reportage",Ashes of Tomorrow: Staubjahre (2022)
