#EXTINF:-1 tvg-id="mv-0430-de-klassiker" tvg-name="Iron Dawn – Sperrzone (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-15.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="6.7" tvg-runtime="114" tvg-cast="Bastian Kohl, Mira Toivonen, Milan Voskuil" tvg-director="Anouk Verhagen" group-title="DE | Klassiker",Iron Dawn – Sperrzone (2025)
