#EXTINF:-1 tvg-id="mv-0136-en-new-movies" tvg-name="Cosmo Crew – Landeklappe (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/cosmo-crew-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/cosmo-crew.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/cosmo-crew.png" tvg-plot="Eine Hundeschnauze, eine Katzenpfote und ein Roboter, der ständig alles doppelt kontrolliert: Die Crew soll nur eine Kiste zum Nachbarmond bringen. Unterwegs geht die Kiste auf — und darin sitzt jemand, der auch nicht weiß, wie er da hineingeraten ist." tvg-genre="Animation, Familie" tvg-age="0" tvg-rating="7.3" tvg-runtime="84" tvg-cast="Mira Toivonen, Milan Voskuil, Hedda Wulfson" tvg-director="Halvard Nyström" group-title="EN | New Movies",Cosmo Crew – Landeklappe (2023)
