#EXTINF:-1 tvg-id="mv-0339-de-4k-uhd-filme" tvg-name="Eclipse Protocol: Rückflugfenster (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/eclipse-protocol-12.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/eclipse-protocol.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/eclipse-protocol.png" tvg-plot="Eine Forschungsstation am Rand des Sonnensystems meldet sich nach acht Monaten Funkstille zurück — mit Daten, die niemand bestellt hat. Das Team, das nachsehen soll, findet eine Anlage vor, die weiterlief, als wäre nie jemand weggewesen." tvg-genre="Science Fiction, Mystery" tvg-age="12" tvg-rating="6.6" tvg-runtime="134" tvg-cast="Emil Ravnborg, Thea Lindgren, Jonan Petrescu" tvg-director="Céline Marchand" group-title="DE | 4K UHD Filme",Eclipse Protocol: Rückflugfenster (2026)
