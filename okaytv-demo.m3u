#EXTINF:-1 tvg-id="mv-0127-en-new-movies" tvg-name="Beyond Horizons – Mittagshöhe (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.8" tvg-runtime="98" tvg-cast="Ivar Bengtsson, Milan Voskuil, Ivar Bengtsson" tvg-director="Halvard Nyström" group-title="EN | New Movies",Beyond Horizons – Mittagshöhe (2022)
