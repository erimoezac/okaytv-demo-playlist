#EXTINF:-1 tvg-id="mv-0451-de-komodie" tvg-name="Northbound: Rentierpfad (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.1" tvg-runtime="119" tvg-cast="Jonan Petrescu, Emil Ravnborg, Marek Halvorsen" tvg-director="Anouk Verhagen" group-title="DE | Komödie",Northbound: Rentierpfad (2023)
