#EXTINF:-1 tvg-id="mv-0034-de-filmreihen-boxsets" tvg-name="Ashes of Tomorrow: Rebirth (2023)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-02.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="6.7" tvg-runtime="134" tvg-cast="Vera Ahlgren, Sanna Lindqvist, Emil Ravnborg" tvg-director="Mira Kaltenbach" group-title="DE | Filmreihen & Boxsets",Ashes of Tomorrow: Rebirth (2023)
