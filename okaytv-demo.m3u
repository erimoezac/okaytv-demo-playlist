#EXTINF:-1 tvg-id="mv-0397-tr-filmler" tvg-name="Beyond Horizons: Nordhang (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-14.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.9" tvg-runtime="102" tvg-cast="Roman Kesselring, Selma Rutkowski, Arno Delacroix" tvg-director="Stellan Broch" group-title="TR | Filmler",Beyond Horizons: Nordhang (2022)
