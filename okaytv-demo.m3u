#EXTINF:-1 tvg-id="mv-0125-en-new-movies" tvg-name="Neon Harbor – Nachtschicht (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-05.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="6.9" tvg-runtime="105" tvg-cast="Liv Aarhusen, Arno Delacroix, Jonan Petrescu" tvg-director="Anouk Verhagen" group-title="EN | New Movies",Neon Harbor – Nachtschicht (2022)
