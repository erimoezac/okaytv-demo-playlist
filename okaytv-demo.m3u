#EXTINF:-1 tvg-id="mv-0317-en-drama-romance" tvg-name="Lanternwood – Brombeerhecke" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="7.1" tvg-runtime="92" tvg-cast="Thea Lindgren, Marek Halvorsen, Juno Marchetti" tvg-director="Piet Vandersteen" group-title="EN | Drama & Romance",Lanternwood – Brombeerhecke
