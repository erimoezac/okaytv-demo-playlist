#EXTINF:-1 tvg-id="mv-0184-it-film" tvg-name="Ashes of Tomorrow – Sirenen (2020)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-07.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="6.5" tvg-runtime="111" tvg-cast="Freya Ostberg, Hedda Wulfson, Ivar Bengtsson" tvg-director="Katrin Sjöberg" group-title="IT | Film",Ashes of Tomorrow – Sirenen (2020)
