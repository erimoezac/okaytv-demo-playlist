#EXTINF:-1 tvg-id="mv-0211-en-action" tvg-name="Northbound: Kalte Spur" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-08.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="7.9" tvg-runtime="99" tvg-cast="Mira Toivonen, Milan Voskuil, Thea Lindgren" tvg-director="Yannick Roussel" group-title="EN | Action",Northbound: Kalte Spur
