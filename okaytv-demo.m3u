#EXTINF:-1 tvg-id="sr-box-midnight-circuit-protokoll-s1" tvg-name="Midnight Circuit: Protokoll S01 (Komplette Staffel)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/midnight-circuit-03.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/midnight-circuit.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/midnight-circuit.png" tvg-plot="In einer Stadt, die jede Bewegung protokolliert, sucht ein Ermittler nach einer Nacht, die aus allen Aufzeichnungen verschwunden ist. Je näher er kommt, desto klarer wird: Das System vergisst nichts — es wurde gebeten, sich zu erinnern." tvg-genre="Science Fiction, Thriller" tvg-age="16" tvg-rating="7.7" tvg-runtime="139" tvg-cast="Aleks Norrback, Milan Voskuil, Freya Ostberg" tvg-director="Piet Vandersteen" group-title="DE | Serien Boxsets",Midnight Circuit: Protokoll S01 (Komplette Staffel)
