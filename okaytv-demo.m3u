#EXTINF:-1 tvg-id="mv-0454-de-komodie" tvg-name="Ashes of Tomorrow: Morgengrauen (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-16.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="7.5" tvg-runtime="112" tvg-cast="Arno Delacroix, Mira Toivonen, Roman Kesselring" tvg-director="Mira Kaltenbach" group-title="DE | Komödie",Ashes of Tomorrow: Morgengrauen (2022)
