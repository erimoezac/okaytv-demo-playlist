#EXTINF:-1 tvg-id="mv-0427-de-klassiker" tvg-name="Beyond Horizons – Schneefeld (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-15.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="8.2" tvg-runtime="109" tvg-cast="Aleks Norrback, Roman Kesselring, Ines Brandtner" tvg-director="Mira Kaltenbach" group-title="DE | Klassiker",Beyond Horizons – Schneefeld (2025)
