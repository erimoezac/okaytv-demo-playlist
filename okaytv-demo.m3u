#EXTINF:-1 tvg-id="mv-0001-de-action-abenteuer" tvg-name="Northbound (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/northbound-01.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/northbound.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/northbound.png" tvg-plot="Ein Fahrer bringt einen Konvoi über die letzte offene Passstraße nach Norden, bevor der Winter sie für Monate schließt. Als der Funk abreißt, wird aus der Route eine Frage von Vertrauen — und aus dem Wetter der kleinste seiner Gegner." tvg-genre="Abenteuer, Thriller" tvg-age="12" tvg-rating="6.4" tvg-runtime="124" tvg-cast="Sanna Lindqvist, Roman Kesselring, Hedda Wulfson" tvg-director="Halvard Nyström" group-title="DE | Action & Abenteuer",Northbound (2022)
