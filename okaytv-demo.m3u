#EXTINF:-1 tvg-id="mv-0004-fr-films" tvg-name="Ashes of Tomorrow (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-01.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="7.2" tvg-runtime="127" tvg-cast="Nora Vestergaard, Hedda Wulfson, Aleks Norrback" tvg-director="Yannick Roussel" group-title="FR | Films",Ashes of Tomorrow (2021)
