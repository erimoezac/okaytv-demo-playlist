#EXTINF:-1 tvg-id="mv-0377-de-drama" tvg-name="Lanternwood – Lichterkette (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="7.9" tvg-runtime="97" tvg-cast="Ivar Bengtsson, Vera Ahlgren, Roman Kesselring" tvg-director="Katrin Sjöberg" group-title="DE | Drama",Lanternwood – Lichterkette (2024)
