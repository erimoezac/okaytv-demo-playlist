#EXTINF:-1 tvg-id="mv-0156-de-doku-reportage" tvg-name="After the Fall: Rankenwerk (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/after-the-fall-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/after-the-fall.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/after-the-fall.png" tvg-plot="Dreißig Jahre nachdem die Städte leer wurden, wächst zwischen den Hochhäusern ein Wald. Ein Kundschafter soll herausfinden, wer die Signale sendet, die seit dem Frühjahr aus dem alten Zentrum kommen — und was aus denen wurde, die nie gegangen sind." tvg-genre="Science Fiction, Drama" tvg-age="12" tvg-rating="6.8" tvg-runtime="124" tvg-cast="Nora Vestergaard, Nikolas Ferrand, Rieke Sandmann" tvg-director="Yannick Roussel" group-title="DE | Doku & Reportage",After the Fall: Rankenwerk (2021)
