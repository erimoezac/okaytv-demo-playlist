#EXTINF:-1 tvg-id="mv-0307-en-drama-romance" tvg-name="Beyond Horizons – Hochtal" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.1" tvg-runtime="113" tvg-cast="Emil Ravnborg, Ivar Bengtsson, Thea Lindgren" tvg-director="Rasmus Ehlert" group-title="EN | Drama & Romance",Beyond Horizons – Hochtal
