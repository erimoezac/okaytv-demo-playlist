#EXTINF:-1 tvg-id="mv-0370-de-drama" tvg-name="Iron Dawn – Marschbefehl (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="7.6" tvg-runtime="140" tvg-cast="Rieke Sandmann, Juno Marchetti, Ines Brandtner" tvg-director="Anouk Verhagen" group-title="DE | Drama",Iron Dawn – Marschbefehl (2024)
