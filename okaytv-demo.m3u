#EXTINF:-1 tvg-id="mv-0424-de-klassiker" tvg-name="Ashes of Tomorrow – Feuerlinie (2025)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/ashes-of-tomorrow-15.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/ashes-of-tomorrow.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/ashes-of-tomorrow.png" tvg-plot="Jahre nach dem Ende sammelt eine Überlebende ein, was von den Städten übrig ist: Werkzeuge, Namen, Erinnerungen. Als aus dem Süden ein Funkspruch kommt, muss sie entscheiden, ob die Zukunft ein Ort ist, zu dem man zurückgeht." tvg-genre="Science Fiction, Drama" tvg-age="16" tvg-rating="6.8" tvg-runtime="125" tvg-cast="Bastian Kohl, Juno Marchetti, Aleks Norrback" tvg-director="Anouk Verhagen" group-title="DE | Klassiker",Ashes of Tomorrow – Feuerlinie (2025)
