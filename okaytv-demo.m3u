#EXTINF:-1 tvg-id="mv-0167-de-doku-reportage" tvg-name="Lanternwood: Glühwürmchen (2021)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/lanternwood-06.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/lanternwood.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/lanternwood.png" tvg-plot="Im Wald hinter dem Dorf gehen seit Tagen die Lichter an, obwohl niemand sie anzündet. Ein Mädchen folgt ihnen mit einer alten Laterne und einem Fuchs, der genau weiß, wo man nicht hintreten darf." tvg-genre="Animation, Fantasy" tvg-age="6" tvg-rating="8.0" tvg-runtime="87" tvg-cast="Hedda Wulfson, Nora Vestergaard, Bastian Kohl" tvg-director="Katrin Sjöberg" group-title="DE | Doku & Reportage",Lanternwood: Glühwürmchen (2021)
