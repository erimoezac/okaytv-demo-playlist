#EXTINF:-1 tvg-id="mv-0337-de-4k-uhd-filme" tvg-name="Beyond Horizons: Abendlicht (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-12.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.1" tvg-runtime="113" tvg-cast="Thea Lindgren, Marek Halvorsen, Mira Toivonen" tvg-director="Halvard Nyström" group-title="DE | 4K UHD Filme",Beyond Horizons: Abendlicht (2026)
