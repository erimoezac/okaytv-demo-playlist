#EXTINF:-1 tvg-id="mv-0095-es-peliculas" tvg-name="Neon Harbor: Kaikante (2026)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/neon-harbor-04.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/neon-harbor.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/neon-harbor.png" tvg-plot="Zwei Ermittler, ein Hafen, eine Leiche zwischen den Containern. Ihre Fälle laufen auf dieselbe Reederei zu — und auf eine Nachtschicht, in der beide entscheiden müssen, wem im Revier sie noch trauen." tvg-genre="Krimi, Thriller" tvg-age="16" tvg-rating="7.5" tvg-runtime="122" tvg-cast="Jonan Petrescu, Liv Aarhusen, Nikolas Ferrand" tvg-director="Piet Vandersteen" group-title="ES | Películas",Neon Harbor: Kaikante (2026)
