#EXTINF:-1 tvg-id="mv-0367-de-drama" tvg-name="Beyond Horizons – Kartenrand (2024)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/beyond-horizons-13.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/beyond-horizons.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/beyond-horizons.png" tvg-plot="Eine Vermesserin zieht allein durch ein Hochtal, das auf keiner Karte richtig eingezeichnet ist. Je weiter sie kommt, desto mehr wird aus der Arbeit eine Auseinandersetzung mit der Frage, warum sie überhaupt losgegangen ist." tvg-genre="Abenteuer, Drama" tvg-age="6" tvg-rating="7.4" tvg-runtime="113" tvg-cast="Cassian Merle, Aleks Norrback, Juno Marchetti" tvg-director="Stellan Broch" group-title="DE | Drama",Beyond Horizons – Kartenrand (2024)
