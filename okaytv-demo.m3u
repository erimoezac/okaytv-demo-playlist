#EXTINF:-1 tvg-id="mv-0396-tr-filmler" tvg-name="After the Fall: Straßenbahnschacht (2022)" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/after-the-fall-14.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/after-the-fall.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/after-the-fall.png" tvg-plot="Dreißig Jahre nachdem die Städte leer wurden, wächst zwischen den Hochhäusern ein Wald. Ein Kundschafter soll herausfinden, wer die Signale sendet, die seit dem Frühjahr aus dem alten Zentrum kommen — und was aus denen wurde, die nie gegangen sind." tvg-genre="Science Fiction, Drama" tvg-age="12" tvg-rating="7.7" tvg-runtime="128" tvg-cast="Juno Marchetti, Jonan Petrescu, Milan Voskuil" tvg-director="Mira Kaltenbach" group-title="TR | Filmler",After the Fall: Straßenbahnschacht (2022)
