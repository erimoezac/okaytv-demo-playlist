#EXTINF:-1 tvg-id="mv-0310-en-drama-romance" tvg-name="Iron Dawn – Brückenkopf" tvg-logo="https://erimoezac.github.io/okaytv-demo-playlist/covers/iron-dawn-11.jpg" tvg-backdrop="https://erimoezac.github.io/okaytv-demo-playlist/hero/iron-dawn.jpg" tvg-titlelogo="https://erimoezac.github.io/okaytv-demo-playlist/logos/iron-dawn.png" tvg-plot="Ein Bergungstrupp arbeitet sich durch eine Stadt, aus der die Front vor Wochen abgezogen ist. Ihr Auftrag lautet Material, ihre Listen füllen sich mit Namen — und irgendwann steht die Frage im Raum, wofür sie eigentlich noch aufräumen." tvg-genre="Kriegsfilm, Drama" tvg-age="16" tvg-rating="7.7" tvg-runtime="119" tvg-cast="Freya Ostberg, Rieke Sandmann, Nikolas Ferrand" tvg-director="Rasmus Ehlert" group-title="EN | Drama & Romance",Iron Dawn – Brückenkopf
